# ============================================================================
# TaskForge — environment configuration
# Copy this file to .env (root, for docker-compose) and/or frontend/.env.local
# and agent-service/.env as needed. NEVER commit real values.
# ============================================================================

# --- Supabase -----------------------------------------------------------
# Create a project at https://supabase.com, then read these from
# Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key: SERVER-SIDE ONLY. Never exposed to the browser, never
# used by frontend/app code — only by frontend API routes' admin client and
# the agent-service.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Same values, unprefixed, for the Python agent-service:
SUPABASE_URL=https://your-project.supabase.co

# --- Agent service --------------------------------------------------------
# Base URL the Next.js server uses to reach the Python agent service.
AGENT_SERVICE_URL=http://localhost:8000
# Shared secret both sides check on every request between Next.js <-> agent
# service. Generate with: openssl rand -hex 32
AGENT_SERVICE_SECRET=change-me-to-a-long-random-secret

# --- AI model ---------------------------------------------------------
# Provider used by the Strands agent for planning/classification/tool
# selection. Supported: "anthropic" (default).
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-5
AI_API_KEY=sk-ant-your-key-here

# --- Worker / scheduler -----------------------------------------------
WORKER_POLL_INTERVAL_SECONDS=15
WORKER_MAX_CONCURRENT_EXECUTIONS=5

# --- App ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
